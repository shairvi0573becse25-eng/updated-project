{"index": {"bodyClass": "page-home", "title": "Home | Campus Events", "html": "\n\n<nav class=\"navbar\">\n <div class=\"nav-inner\">\n  <a href=\"index.html\" class=\"logo\"><span class=\"logo-mark\">✦</span><span>CAMPUS<br>EVENTS<small>PLAN. PARTY. MAKE MEMORIES.</small></span></a>\n  <button class=\"menu-btn\">☰</button>\n  <div class=\"nav-links\">\n   <a href=\"index.html\">Home</a><a href=\"events.html\">Events</a><a href=\"planner.html\">Planner</a><a href=\"clubs.html\">Clubs</a><a href=\"gallery.html\">Gallery</a><a href=\"contact.html\">Contact</a><a href=\"auth.html\">Login</a>\n   <a class=\"btn small primary\" href=\"create-event.html\">Create Event ✨</a>\n  </div>\n </div>\n</nav>\n\n\n<section class=\"hero\"><div class=\"container\"><div class=\"hero-content\">\n <div class=\"kicker\">✦ Your campus. Your events. Your memories.</div>\n <h1>College Life,<br><span>Epic Events!</span></h1>\n <p>From coding battles to DJ nights, discover events, connect with students and create unforgettable campus memories.</p>\n <div class=\"hero-actions\"><a class=\"btn primary\" href=\"events.html\">Explore Events →</a><a class=\"btn\" href=\"create-event.html\">Create Event ✨</a></div>\n </div>\n <div class=\"countdown\" aria-live=\"polite\"><h3>Next Big Event</h3><strong id=\"nextTitle\">Loading...</strong><div class=\"timer\" id=\"timer\"></div><a class=\"countdown-link\" href=\"events.html\">View event details →</a></div>\n</div></div></section>\n<section class=\"section\"><div class=\"container\"><h2 class=\"section-title\">🔥 Trending Events</h2><div class=\"grid events-grid\" id=\"homeEvents\"></div></div></section>\n<section class=\"section alt\"><div class=\"container\"><h2 class=\"section-title\">🎉 Explore by Category</h2><div class=\"grid category-grid\">\n <a class=\"category\" href=\"events.html?category=Coding\"><div class=\"icon watercolor-icon\" data-icon=\"code\" aria-hidden=\"true\"></div><h4>Coding</h4></a>\n <a class=\"category\" href=\"events.html?category=DJ%20Night\"><div class=\"icon watercolor-icon\" data-icon=\"music\" aria-hidden=\"true\"></div><h4>DJ Nights</h4></a>\n <a class=\"category\" href=\"events.html?category=Hackathon\"><div class=\"icon watercolor-icon\" data-icon=\"rocket\" aria-hidden=\"true\"></div><h4>Hackathons</h4></a>\n <a class=\"category\" href=\"events.html?category=College%20Fest\"><div class=\"icon watercolor-icon\" data-icon=\"celebration\" aria-hidden=\"true\"></div><h4>College Fests</h4></a>\n <a class=\"category\" href=\"events.html?category=Workshop\"><div class=\"icon watercolor-icon\" data-icon=\"palette\" aria-hidden=\"true\"></div><h4>Workshops</h4></a>\n <a class=\"category\" href=\"events.html?category=Sports\"><div class=\"icon watercolor-icon\" data-icon=\"trophy\" aria-hidden=\"true\"></div><h4>Sports</h4></a>\n</div></div></section>\n<section class=\"section\"><div class=\"container\"><h2 class=\"section-title\">🧰 Plan Smart. Stay Ahead.</h2><div class=\"grid tools-grid\">\n <div class=\"tool\"><div class=\"tool-icon watercolor-icon\" data-icon=\"calendar\" aria-hidden=\"true\"></div><h3>Event Calendar</h3><p>See your saved and registered events in one place.</p></div>\n <div class=\"tool\"><div class=\"tool-icon watercolor-icon\" data-icon=\"users\" aria-hidden=\"true\"></div><h3>Guest List</h3><p>Keep track of registrations and attendees.</p></div>\n <div class=\"tool\"><div class=\"tool-icon watercolor-icon\" data-icon=\"wallet\" aria-hidden=\"true\"></div><h3>Budget Tracker</h3><p>Plan event expenses and stay on budget.</p></div>\n <div class=\"tool\"><div class=\"tool-icon watercolor-icon\" data-icon=\"checklist\" aria-hidden=\"true\"></div><h3>Task Manager</h3><p>Break your event into simple tasks.</p></div>\n <div class=\"tool\"><div class=\"tool-icon watercolor-icon\" data-icon=\"bell\" aria-hidden=\"true\"></div><h3>Reminders</h3><p>Never miss an important deadline.</p></div>\n <div class=\"tool\"><div class=\"tool-icon watercolor-icon\" data-icon=\"pin\" aria-hidden=\"true\"></div><h3>Venue Booking</h3><p>Find the perfect campus venue.</p></div>\n</div></div></section>\n\n\n<footer class=\"footer\"><div class=\"container\">\n <div class=\"footer-grid\">\n  <div><h3>Campus Events</h3><p style=\"margin-top:10px;color:#ddd;line-height:1.6\">We don't just plan events — we create campus experiences.</p></div>\n  <div><h4>Quick Links</h4><a href=\"index.html\">Home</a><a href=\"events.html\">Events</a><a href=\"planner.html\">Planner</a><a href=\"clubs.html\">Clubs</a></div>\n  <div><h4>Categories</h4><a href=\"events.html\">Coding</a><a href=\"events.html\">DJ Nights</a><a href=\"events.html\">Hackathons</a><a href=\"events.html\">Fests</a></div>\n  <div><h4>Contact</h4><a href=\"contact.html\">hello@campusevents.com</a><a href=\"contact.html\">+91 98765 43210</a><a href=\"contact.html\">Your College Campus</a></div>\n </div>\n <div class=\"copyright\">© <span id=\"year\"></span> Campus Events. All rights reserved. ♥</div>\n</div></footer><div id=\"toast\" class=\"toast\"></div>\n\n\n", "scripts": [{"src": "js/data.js"}, {"src": "js/main.js"}, {"inline": "\ndocument.addEventListener(\"DOMContentLoaded\",()=>{\n const homeGrid=document.querySelector(\"#homeEvents\");\n const now=new Date();\n const events=getEvents().sort((a,b)=>new Date(a.date+\"T\"+a.time)-new Date(b.date+\"T\"+b.time));\n if(homeGrid) homeGrid.innerHTML=events.filter(e=>new Date(e.date+\"T\"+e.time)>=now).slice(0,4).map(eventCard).join(\"\") || '<div class=\"empty\" style=\"grid-column:1/-1\">No upcoming events yet. Check back soon!</div>';\n const next=events.find(e=>new Date(e.date+\"T\"+e.time)>now);\n const title=document.querySelector(\"#nextTitle\"), timer=document.querySelector(\"#timer\");\n if(!next){title.textContent=\"New events coming soon!\";timer.innerHTML=\"<p>Stay tuned for the next campus experience.</p>\";return;}\n title.textContent=next.title;\n const target=new Date(next.date+\"T\"+next.time);\n function tick(){\n   const remaining=target-new Date();\n   if(remaining<=0){title.textContent=\"Happening now!\";timer.innerHTML=\"<p>Check the events page for more.</p>\";return;}\n   let seconds=Math.floor(remaining/1000);const days=Math.floor(seconds/86400);seconds%=86400;\n   const hours=Math.floor(seconds/3600);seconds%=3600;const mins=Math.floor(seconds/60);seconds%=60;\n   timer.innerHTML=`<div><b>${days}</b><span>days</span></div><div><b>${hours}</b><span>hrs</span></div><div><b>${mins}</b><span>mins</span></div><div><b>${seconds}</b><span>secs</span></div>`;\n }\n tick();setInterval(tick,1000);\n});\n"}]}, "events": {"bodyClass": "page-events", "title": "All Events | Campus Events", "html": "\n\n<nav class=\"navbar\">\n <div class=\"nav-inner\">\n  <a href=\"index.html\" class=\"logo\"><span class=\"logo-mark\">✦</span><span>CAMPUS<br>EVENTS<small>PLAN. PARTY. MAKE MEMORIES.</small></span></a>\n  <button class=\"menu-btn\">☰</button>\n  <div class=\"nav-links\">\n   <a href=\"index.html\">Home</a><a href=\"events.html\">Events</a><a href=\"planner.html\">Planner</a><a href=\"clubs.html\">Clubs</a><a href=\"gallery.html\">Gallery</a><a href=\"contact.html\">Contact</a><a href=\"auth.html\">Login</a>\n   <a class=\"btn small primary\" href=\"create-event.html\">Create Event ✨</a>\n  </div>\n </div>\n</nav>\n\n\n<main class=\"container\"><section class=\"page-head\"><h1>All Events</h1><p>Find, explore and register for exciting campus events.</p></section>\n<input class=\"search\" id=\"eventSearch\" placeholder=\"🔎 Search by event, category or venue...\" aria-label=\"Search events\">\n<label class=\"sort-wrap\" for=\"eventSort\">Sort events <select id=\"eventSort\" class=\"sort-select\"><option value=\"date\">Soonest first</option><option value=\"name\">Event name (A–Z)</option><option value=\"popular\">Most seats filled</option></select></label>\n<div class=\"filters\"><button class=\"filter active\" data-category=\"All\">All</button><button class=\"filter\" data-category=\"Coding\">Coding</button><button class=\"filter\" data-category=\"DJ Night\">DJ & Music</button><button class=\"filter\" data-category=\"Hackathon\">Hackathons</button><button class=\"filter\" data-category=\"College Fest\">Fests</button><button class=\"filter\" data-category=\"Sports\">Sports</button><button class=\"filter\" data-category=\"Workshop\">Workshops</button></div>\n<section class=\"section\" style=\"padding-top:10px\"><div class=\"grid events-grid\" id=\"eventsGrid\"></div></section></main>\n\n\n<footer class=\"footer\"><div class=\"container\">\n <div class=\"footer-grid\">\n  <div><h3>Campus Events</h3><p style=\"margin-top:10px;color:#ddd;line-height:1.6\">We don't just plan events — we create campus experiences.</p></div>\n  <div><h4>Quick Links</h4><a href=\"index.html\">Home</a><a href=\"events.html\">Events</a><a href=\"planner.html\">Planner</a><a href=\"clubs.html\">Clubs</a></div>\n  <div><h4>Categories</h4><a href=\"events.html\">Coding</a><a href=\"events.html\">DJ Nights</a><a href=\"events.html\">Hackathons</a><a href=\"events.html\">Fests</a></div>\n  <div><h4>Contact</h4><a href=\"contact.html\">hello@campusevents.com</a><a href=\"contact.html\">+91 98765 43210</a><a href=\"contact.html\">Your College Campus</a></div>\n </div>\n <div class=\"copyright\">© <span id=\"year\"></span> Campus Events. All rights reserved. ♥</div>\n</div></footer><div id=\"toast\" class=\"toast\"></div>\n\n\n", "scripts": [{"src": "js/data.js"}, {"src": "js/main.js"}, {"src": "js/events.js"}]}, "planner": {"bodyClass": "page-planner", "title": "Planner | Campus Events", "html": "\n\n<nav class=\"navbar\">\n <div class=\"nav-inner\">\n  <a href=\"index.html\" class=\"logo\"><span class=\"logo-mark\">✦</span><span>CAMPUS<br>EVENTS<small>PLAN. PARTY. MAKE MEMORIES.</small></span></a>\n  <button class=\"menu-btn\">☰</button>\n  <div class=\"nav-links\">\n   <a href=\"index.html\">Home</a><a href=\"events.html\">Events</a><a href=\"planner.html\">Planner</a><a href=\"clubs.html\">Clubs</a